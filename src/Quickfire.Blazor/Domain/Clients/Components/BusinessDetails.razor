@page "/businessdetailseditor/{ClientId:int}"
@inherits BusinessDetailsEditorBase

@* Keep @using statements relevant to the Razor markup *@
@using Quickfire.Blazor.Domain.Clients.Models
@using Quickfire.Blazor.Domain.Shared.Models
@using Syncfusion.Blazor.InPlaceEditor
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Inputs
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons
@using Syncfusion.Blazor.Buttons

@if (BusinessDetails != null)
{
    <EditForm EditContext="@MyEditContext">
        <FluentStack HorizontalGap="20">

            <div class="pol-section-column-1">

                <!--=====----- BASICS -----=====-->
                <span class="pol-section-title" style="border-left: 5px solid #046BC4;">Basics</span>
                <div class="pol-section-container">

                    
                    <!-- Short Description -->
                    <div class="var-name">
                        Business Description
                        <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.ShortDescription))"><FluentIcon Value="@(new Icons.Regular.Size16.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                    </div>
                    <div class="var-value e-small">
                        <SfTextArea @bind-Value="@BusinessDetails.ShortDescription" @onblur="SaveChanges" Width="325px" style="height:53px;"></SfTextArea>
                    </div>

                    <!-- Long Description -->
                    @if (ShouldShowField(BusinessDetails.LongDescription))
                    {
                        <div class="var-name">
                            Operations Description
                            <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.LongDescription))"><FluentIcon Value="@(new Icons.Regular.Size16.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                        </div>
                        <div class="var-value-nopad e-small">
                            <SfTextArea @bind-Value="@BusinessDetails.LongDescription" Multiline="true" @onblur="SaveChanges" Width="325px" style="height:53px;"></SfTextArea>
                        </div>
                    }

                    <FluentStack>
                        <div class="smallsplit-1">
                            @if (ShouldShowField(BusinessDetails.YearsExperience))
                            {
                                <!-- Years Experience -->
                                <SfNumericTextBox CssClass="e-smaller" ShowSpinButton=false FloatLabelType="FloatLabelType.Always" Placeholder="Years Experienced" Format="n0" @bind-Value="@BusinessDetails.YearsExperience" @onblur="SaveChanges"></SfNumericTextBox>
                            }
                        </div>
                        <div class="smallsplit-2">
                            <!-- Number of Claims -->
                            @if (ShouldShowField(BusinessDetails.NumClaims))
                            {
                                <SfNumericTextBox CssClass="e-smaller" ShowSpinButton=false FloatLabelType="FloatLabelType.Always" Placeholder="Total Claims" Format="n0" @bind-Value="@BusinessDetails.NumClaims" @onblur="SaveChanges"></SfNumericTextBox>
                            }
                        </div>
                    </FluentStack>

                    <FluentStack HorizontalGap="40">
                        <div class="smallsplit-3">
                            <!-- Date Started -->
                            <SfDatePicker CssClass="e-small" TValue="DateTime?" @bind-Value="BusinessDetails.DateStarted" Placeholder="Date Started" FloatLabelType="FloatLabelType.Always" OnChange="@(args => SaveChanges())" />
                        </div>
                        <div class="smallsplit-4">
                            <!-- FEIN -->
                             <SfTextBox CssClass="e-small" @bind-Value="@BusinessDetails.FEIN" @onblur="SaveChanges" Placeholder="FEIN" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                         </div>
                    </FluentStack>

                </div>

                <div class="pol-column-spacer"></div>

                <!--=====----- CLASSIFICATIONS -----=====-->
                <span class="pol-section-title" style="border-left: 5px solid #1B8CE3;">Classifications</span><br />
                <div class="pol-section-container">

                    <!-- Legal Entity Type -->
                    <span class="pol-name">
                            Legal Entity Type
                            <span class="copy-btn"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                        </span>
                    <span class="pol-value">
                        <SfDropDownList TValue="LegalEntityType?" TItem="LocalEnumData<LegalEntityType>" @bind-Value="@BusinessDetails.LegalEntityType" DataSource="@LegalEntityTypeList" CssClass="e-small"
                                        FloatLabelType="FloatLabelType.Never" AllowFiltering="true" ShowClearButton="true">
                            <DropDownListEvents TValue="LegalEntityType?" TItem="LocalEnumData<LegalEntityType>" ValueChange="@(args => OnFieldChanged(nameof(BusinessDetails.LegalEntityType)))" />
                            <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </span><br />

                    <!-- Business Type -->
                    @if (ShouldShowField(BusinessDetails.BusinessType))
                    {
                        <span class="pol-name">
                            Business Type
                            <span class="copy-btn"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                        </span>
                        <span class="pol-value">
                            <SfDropDownList TValue="BusinessType?" TItem="LocalEnumData<BusinessType>" @bind-Value="@BusinessDetails.BusinessType" DataSource="@BusinessTypeList"  CssClass="e-small"
                                            FloatLabelType="FloatLabelType.Never" AllowFiltering="true" ShowClearButton="true">
                                <DropDownListEvents TValue="BusinessType?" TItem="LocalEnumData<BusinessType>" ValueChange="@(args => OnFieldChanged(nameof(BusinessDetails.BusinessType)))" />
                                <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </span><br />
                    }


                    <!-- Business Industry -->
                    @if (ShouldShowField(BusinessDetails.BusinessIndustry))
                    {
                        <span class="pol-name">
                            SIC / Industry
                            <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.BusinessIndustry))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                        </span>
                        <span class="pol-value">
                            <FluentStack>
                                <div class="code-field">
                                    <SfTextBox CssClass="e-small" @bind-Value="@BusinessDetails.SicCodes" @onblur="SaveChanges"></SfTextBox>
                                </div>
                                <div>
                                    <SfTextBox CssClass="e-small" @bind-Value="@BusinessDetails.BusinessIndustry" @onblur="SaveChanges"></SfTextBox>
                                </div>
                            </FluentStack>
                        </span><br />
                    }

                    <!-- Business Specialty -->
                    @if (ShouldShowField(BusinessDetails.BusinessSpecialty))
                    {
                        <span class="pol-name">
                            NCAIS / Specialty
                            <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.BusinessSpecialty))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                        </span>
                        <span class="pol-value">
                            <FluentStack>
                                <div class="code-field">
                                    <SfTextBox CssClass="e-small" @bind-Value="@BusinessDetails.NaicsCodes" @onblur="SaveChanges"></SfTextBox>
                                </div>
                                <div>
                                    <SfTextBox CssClass="e-small" @bind-Value="@BusinessDetails.BusinessSpecialty" @onblur="SaveChanges"></SfTextBox>
                                </div>
                            </FluentStack>
                            
                        </span>
                    }
                </div>
           
            </div>

            <div class="pol-section-column-2">


                <!--=====----- EMPLOYEES -----=====-->
                <span class="pol-section-title" style="border-left: 5px solid #593294;">Employees</span>
                <div class="pol-section-container">

                    <!-- Number of Part-Time Employees -->
                    <span class="pol-name">
                        Part-Time
                        <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.NumPartTimeEmployees.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                    </span>
                    <span class="pol-value-mid">
                        <SfNumericTextBox CssClass="e-smaller" Format="n0" @bind-Value="@BusinessDetails.NumPartTimeEmployees" @onblur="SaveChanges"></SfNumericTextBox>
                    </span><br />

                    <!-- Number of Full-Time Employees -->
                    <span class="pol-name">
                        Full-Time
                        <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.NumFullTimeEmployees.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                    </span>
                    <span class="pol-value-mid">
                        <SfNumericTextBox CssClass="e-smaller" Format="n0" @bind-Value="@BusinessDetails.NumFullTimeEmployees" @onblur="SaveChanges"></SfNumericTextBox>
                    </span><br />
                </div>


                <!--=====----- PAYROLL -----=====-->
                @if (ShouldShowSection(BusinessDetails.EstimatedAnnualPayroll0, BusinessDetails.EstimatedAnnualPayroll1, BusinessDetails.EstimatedAnnualPayroll2, BusinessDetails.EstimatedAnnualPayroll3, BusinessDetails.EstimatedAnnualPayroll4))
                {
                    <span class="pol-section-title" style="border-left: 5px solid #745DA1;">Payroll</span><br />
                    <div class="pol-section-container">


                        @if (ShouldShowField(BusinessDetails.EstimatedAnnualPayroll0))
                        {
                            <span class="pol-name">
                                Next Year
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedAnnualPayroll0.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedAnnualPayroll0" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedAnnualPayroll1))
                        {
                            <span class="pol-name">
                                Current
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedAnnualPayroll1.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedAnnualPayroll1" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedAnnualPayroll2))
                        {
                            <span class="pol-name">
                                Previous Year
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedAnnualPayroll2.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedAnnualPayroll2" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedAnnualPayroll3))
                        {
                            <span class="pol-name">
                                2 Years Ago
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedAnnualPayroll3.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedAnnualPayroll3" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedAnnualPayroll4))
                        {
                            <span class="pol-name">
                                3 Years Ago
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedAnnualPayroll4.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedAnnualPayroll4" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                    </div>
                }

                <!--=====----- GROSS SALES -----=====-->
                @if (ShouldShowSection(BusinessDetails.EstimatedGrossSales0, BusinessDetails.EstimatedGrossSales1, BusinessDetails.EstimatedGrossSales2, BusinessDetails.EstimatedGrossSales3, BusinessDetails.EstimatedGrossSales4))
                {
                    <span class="pol-section-title" style="border-left: 5px solid #FF6600;">Gross Sales</span><br />


                    <div class="pol-section-container">
                        @if (ShouldShowField(BusinessDetails.EstimatedGrossSales0))
                        {
                            <span class="pol-name">
                                Next Year
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedGrossSales0.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedGrossSales0" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedGrossSales1))
                        {
                            <span class="pol-name">
                                Current Year
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedGrossSales1.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedGrossSales1" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedGrossSales2))
                        {
                            <span class="pol-name">
                                Last Year
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedGrossSales2.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedGrossSales2" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedGrossSales3))
                        {
                            <span class="pol-name">
                                2 Years Ago
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedGrossSales3.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedGrossSales3" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        @if (ShouldShowField(BusinessDetails.EstimatedGrossSales4))
                        {
                            <span class="pol-name">
                                3 Years Ago
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedGrossSales4.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value-mid">
                                <SfNumericTextBox CssClass="e-smaller" Format="c2" ShowSpinButton=false @bind-Value="@BusinessDetails.EstimatedGrossSales4" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                    </div>
                }
            </div>

            <div class="pol-section-column-3">
                <!--=====----- FINANCIALS -----=====-->
                <span class="pol-section-title" style="border-left: 5px solid #CF4740;">FINANCIALS</span>

                <div class="pol-section-container">
                    <!-- Annual Gross Sales -->
                    <span class="pol-name">
                        Annual Gross Sales
                        <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.AnnualGrossSalesRevenueReceipts.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                    </span>
                    <span class="pol-value e-small">
                        <SfNumericTextBox CssClass="e-smaller" Format="c2" @bind-Value="@BusinessDetails.AnnualGrossSalesRevenueReceipts" @onblur="SaveChanges"></SfNumericTextBox>
                    </span><br />
                   
                    <!-- Annual Payroll -->
                    <span class="pol-name">
                        Annual Payroll
                        <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.AnnualPayrollHazardExposure.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                    </span>
                    <span class="pol-value e-small">
                        <SfNumericTextBox CssClass="e-smaller" Format="c2" @bind-Value="@BusinessDetails.AnnualPayrollHazardExposure" @onblur="SaveChanges"></SfNumericTextBox>
                    </span><br />
                   
                    <!-- Business Property -->
                    <span class="pol-name">
                        Business Property
                        <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.BusinessPersonalPropertyBPP.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                    </span>
                    <span class="pol-value e-small">
                        <SfNumericTextBox CssClass="e-smaller" Format="c2" @bind-Value="@BusinessDetails.BusinessPersonalPropertyBPP" @onblur="SaveChanges"></SfNumericTextBox>
                    </span><br />
                    
                </div>

                <!--=====----- CONTRACTORS -----=====-->
                @if (ShouldShowSection(BusinessDetails.LicenseType, BusinessDetails.LicenseNumber, BusinessDetails.EstimatedSubcontractingExpenses, BusinessDetails.PercentResidential, BusinessDetails.PercentCommercial, BusinessDetails.PercentPublic, BusinessDetails.PercentNewConstruction, BusinessDetails.PercentRemodelRepair, BusinessDetails.PercentInterior, BusinessDetails.PercentExterior))
                { 
                    <span class="pol-section-title" style="border-left: 5px solid #1F1E61;">Contractors</span>
                    <div class="pol-section-container">


                        <!-- License Type -->
                        @if (ShouldShowField(BusinessDetails.LicenseType))
                        {
                            <span class="pol-name">License Type<span class="copy-spcr" /></span>
                            <span class="pol-value e-small">
                                <SfDropDownList TValue="LicenseType?" TItem="LocalEnumData<LicenseType>" @bind-Value="@BusinessDetails.LicenseType" DataSource="@LicenseTypeList"
                                                Placeholder="Select License Type" FloatLabelType="FloatLabelType.Never" AllowFiltering="true" ShowClearButton="true">
                                    <DropDownListEvents TValue="LicenseType?" TItem="LocalEnumData<LicenseType>" ValueChange="@(args => OnFieldChanged(nameof(BusinessDetails.LicenseType)))" />
                                    <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                                </SfDropDownList>
                            </span><br />
                        }

                        <!-- License Number -->
                        @if (ShouldShowField(BusinessDetails.LicenseNumber))
                        {
                            <span class="pol-name">
                                License Number
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.LicenseNumber))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value">
                                <SfTextBox CssClass="e-small" @bind-Value="@BusinessDetails.LicenseNumber" @onblur="SaveChanges"></SfTextBox>
                            </span><br />
                        }

                        <!-- Estimated Subcontracting Expenses -->
                        @if (ShouldShowField(BusinessDetails.EstimatedSubcontractingExpenses))
                        {
                            <span class="pol-name">
                                Sub Costs
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.EstimatedSubcontractingExpenses.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value e-small">
                                <SfNumericTextBox CssClass="e-smaller" Format="c0" @bind-Value="@BusinessDetails.EstimatedSubcontractingExpenses" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />
                        }
                        <div class="perholder">
                            @if (ShouldShowField(BusinessDetails.PercentResidential) || ShouldShowField(BusinessDetails.PercentCommercial) || ShouldShowField(BusinessDetails.PercentPublic))
                            {
                           
                                <FluentStack HorizontalGap="10">
                                    @if (ShouldShowField(BusinessDetails.PercentResidential))
                                    {
                                        <SfTextBox CssClass="e-small" Placeholder="% Residential" FloatLabelType="FloatLabelType.Auto" @bind-Value="@BusinessDetails.PercentResidential" @onblur="SaveChanges"></SfTextBox>
                                    }
                                    @if (ShouldShowField(BusinessDetails.PercentCommercial))
                                    {
                                        <SfTextBox CssClass="e-small" Placeholder="% Commercial" FloatLabelType="FloatLabelType.Auto" @bind-Value="@BusinessDetails.PercentCommercial" @onblur="SaveChanges"></SfTextBox>
                                    }
                                    @if (ShouldShowField(BusinessDetails.PercentPublic))
                                    {
                                        <SfTextBox CssClass="e-small" Placeholder="% Public" FloatLabelType="FloatLabelType.Auto" @bind-Value="@BusinessDetails.PercentPublic" @onblur="SaveChanges"></SfTextBox>
                                    }
                                </FluentStack>
                            }

                            @if (ShouldShowField(BusinessDetails.PercentNewConstruction) || ShouldShowField(BusinessDetails.PercentRemodelRepair))
                            {
                                <FluentStack HorizontalGap="10">
                                    @if (ShouldShowField(BusinessDetails.PercentNewConstruction))
                                    {
                                        <SfTextBox Placeholder="% New Construction" FloatLabelType="FloatLabelType.Auto" CssClass="e-small" @bind-Value="@BusinessDetails.PercentNewConstruction" @onblur="SaveChanges"></SfTextBox>
                                    }
                                    @if (ShouldShowField(BusinessDetails.PercentRemodelRepair))
                                    {
                                        <SfTextBox Placeholder="% Repair" FloatLabelType="FloatLabelType.Auto" CssClass="e-small" @bind-Value="@BusinessDetails.PercentRemodelRepair" @onblur="SaveChanges"></SfTextBox>
                                    }
                                </FluentStack>
                            }

                            @if (ShouldShowField(BusinessDetails.PercentInterior) || ShouldShowField(BusinessDetails.PercentExterior))
                            {
                                <FluentStack HorizontalGap="10">
                                    @if (ShouldShowField(BusinessDetails.PercentInterior))
                                    {
                                        <SfTextBox Placeholder="% Interior" FloatLabelType="FloatLabelType.Auto" CssClass="e-small" @bind-Value="@BusinessDetails.PercentInterior" @onblur="SaveChanges"></SfTextBox>
                                    }
                                    @if (ShouldShowField(BusinessDetails.PercentExterior))
                                    {
                                        <SfTextBox Placeholder="% Exterior" FloatLabelType="FloatLabelType.Auto" CssClass="e-small" @bind-Value="@BusinessDetails.PercentExterior" @onblur="SaveChanges"></SfTextBox>
                                    }
                                </FluentStack>
                            }
                        </div>
                    </div>
                }
                
                

                <!--=====----- PRIMARY BUILDING -----=====-->
                @if (ShouldShowSection(BusinessDetails.BuildingLocationYearBuilt, BusinessDetails.BuildingLocationSquareFootage, BusinessDetails.BuildingLocationNumberOfStories, BusinessDetails.BuildingLocationSprinklered, BusinessDetails.BuildingLocationMonitoredSecurity))

                {

                    <span class="pol-section-title" style="border-left: 5px solid #CF4740;">Primary Building</span>
                    <div class="pol-section-container">
                        <!-- Year Built -->
                        @if (ShouldShowField(BusinessDetails.BuildingLocationYearBuilt))

                        {

                            <span class="pol-name">
                                Year Built
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.BuildingLocationYearBuilt.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value">
                                <SfNumericTextBox CssClass="e-smaller" Format="n0" @bind-Value="@BusinessDetails.BuildingLocationYearBuilt" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />

                        }

                        <!-- Square Footage -->
                        @if (ShouldShowField(BusinessDetails.BuildingLocationSquareFootage))

                        {

                            <span class="pol-name">
                                Square Footage
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.BuildingLocationSquareFootage.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value e-small">
                                <SfNumericTextBox CssClass="e-smaller" Format="n0" @bind-Value="@BusinessDetails.BuildingLocationSquareFootage" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />

                        }

                        <!-- Number of Stories -->
                        @if (ShouldShowField(BusinessDetails.BuildingLocationNumberOfStories))

                        {

                            <span class="pol-name">
                                Number of Stories
                                <span class="copy-btn" @onclick="@(x => CopyItem(BusinessDetails.BuildingLocationNumberOfStories.ToString()))"><FluentIcon Value="@(new Icons.Regular.Size20.Copy())" Slot="start" Color="Color.Custom" CustomColor="#4a4a4a" /></span>
                            </span>
                            <span class="pol-value e-small">
                                <SfNumericTextBox CssClass="e-smaller" Format="n0" @bind-Value="@BusinessDetails.BuildingLocationNumberOfStories" @onblur="SaveChanges"></SfNumericTextBox>
                            </span><br />

                        }
                        <FluentStack>
                            @if (ShouldShowField(BusinessDetails.BuildingLocationSprinklered))
                        {
                            <!-- Sprinklered -->
                            <div class="e-smaller">
                                <SfCheckBox @bind-Checked="@BusinessDetails.BuildingLocationSprinklered" Label="Sprinklered"
                                    ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool?> args) => OnFieldChanged(nameof(BusinessDetails.BuildingLocationSprinklered)))"></SfCheckBox>
                            </div>
                        }
                        @if (ShouldShowField(BusinessDetails.BuildingLocationMonitoredSecurity))
                        {
                             <!-- Monitored Security -->
                            <div class="e-smaller">
                                <SfCheckBox @bind-Checked="@BusinessDetails.BuildingLocationMonitoredSecurity"  Label="Monitored Security"
                                    ValueChange="@((Syncfusion.Blazor.Buttons.ChangeEventArgs<bool?> args) => OnFieldChanged(nameof(BusinessDetails.BuildingLocationMonitoredSecurity)))"></SfCheckBox>
                            </div>
                        }
                        </FluentStack>
                    </div>
                }
            </div>

            <div class="pol-section-column-4">
                <div class="switch-area">
                    <FluentStack HorizontalGap="10" VerticalAlignment="VerticalAlignment.Center">
                        <span class="showall">Show All Fields</span>
                        <FluentSwitch Value="@(FocusMode)" ValueChanged="OnModeSwitchChanged"></FluentSwitch>
                        <span>@(FocusMode ? "No" : "Yes")</span>
                    </FluentStack>
                </div>
            </div>
        </FluentStack>
    </EditForm>
}
else if (BusinessDetails == null)
{
    <p><em>Loading business details...</em></p>
}
<style>
    :root .e-smaller {
        transform: scale(.85);
    }
    :root .modified  {
        border: 0;
    }
</style>
