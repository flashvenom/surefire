    private List<string> GetParentOptions()
    {
        var options = new List<string> { string.Empty };
        if (_selectedPage == null)
        {
            return options;
        }

        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { string.Empty };

        void AddOption(string id)
        {
            if (seen.Add(id))
            {
                options.Add(id);
            }
        }

        if (_selectedPage.ParentPageId.HasValue)
        {
            AddOption(_selectedPage.ParentPageId.Value.ToString());
        }

        var candidates = _pages
            .Where(p => p.CompanyManualPageId != _selectedPage.CompanyManualPageId)
            .ToList();

        if (!string.IsNullOrWhiteSpace(_parentFilter))
        {
            var term = _parentFilter.Trim();
            candidates = candidates
                .Where(p => p.Title.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else if (candidates.Count > ParentPageFilterThreshold)
        {
            candidates = candidates.Where(p => p.ParentPageId == null).ToList();
        }

        foreach (var page in candidates)
        {
            AddOption(page.CompanyManualPageId.ToString());
        }

        return options;
    }

    private string GetParentOptionText(string id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return "-- Root --";
        }

        if (!int.TryParse(id, out var parsed))
