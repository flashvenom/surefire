    private void ToggleNode(int pageId)
    {
        // Accordion behavior: only allow one top-level section expanded at a time
        var clickedPage = _pages.FirstOrDefault(p => p.CompanyManualPageId == pageId);
        if (clickedPage == null)
        {
            return;
        }

        // If this is a top-level page (no parent)
        if (clickedPage.ParentPageId == null)
        {
            if (_expandedPageIds.Contains(pageId))
            {
                // Collapse this section
                _expandedPageIds.Remove(pageId);
            }
            else
            {
                // Collapse all other top-level sections
                var topLevelPageIds = _pages.Where(p => p.ParentPageId == null).Select(p => p.CompanyManualPageId).ToList();
                foreach (var topLevelId in topLevelPageIds)
                {
                    _expandedPageIds.Remove(topLevelId);
                }
                // Expand this section
                _expandedPageIds.Add(pageId);
            }
        }
        else
        {
            // For nested items, just toggle normally
            if (_expandedPageIds.Contains(pageId))
            {
                _expandedPageIds.Remove(pageId);
            }
            else
            {
                _expandedPageIds.Add(pageId);
            }
        }
    }

    private bool IsExpanded(int pageId) => _expandedPageIds.Contains(pageId);

    private void EnsureAncestorsExpanded(int pageId)
    {
        var lookup = _pages.ToDictionary(p => p.CompanyManualPageId, p => p.ParentPageId);
        var current = lookup.TryGetValue(pageId, out var parentId) ? parentId : null;

        // Clear all top-level expansions first (accordion behavior)
        var topLevelPageIds = _pages.Where(p => p.ParentPageId == null).Select(p => p.CompanyManualPageId).ToList();
        foreach (var topLevelId in topLevelPageIds)
        {
            _expandedPageIds.Remove(topLevelId);
        }

        if (!current.HasValue)
        {
            _expandedPageIds.Add(pageId);
            return;
        }

        // Expand the entire ancestor chain
        while (current.HasValue)
        {
            _expandedPageIds.Add(current.Value);
            current = lookup.TryGetValue(current.Value, out var next) ? next : null;
        }
    }

    private const string VideoTitleSuffix = " (Video)";

    private static bool HasVideoSuffix(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return false;
        }

        return title.TrimEnd().EndsWith(VideoTitleSuffix, StringComparison.OrdinalIgnoreCase);
    }

    private static string StripVideoSuffix(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            return string.Empty;
        }

        var trimmed = title.TrimEnd();
        if (!trimmed.EndsWith(VideoTitleSuffix, StringComparison.OrdinalIgnoreCase))
        {
            return trimmed;
        }

        return trimmed.Substring(0, trimmed.Length - VideoTitleSuffix.Length);
    }

