@page "/CompanyManual"
@page "/CompanyManual/{PageSlug}"
@inherits AppComponentBase
@implements IAsyncDisposable
@using Quickfire.Blazor.Domain.CompanyManual.Models
@using Quickfire.Blazor.Domain.CompanyManual.Services
@using Quickfire.Blazor.Domain.Renewals.Models
@using Quickfire.Blazor.Domain.Renewals.Services
@using Quickfire.Blazor.Domain.Shared.Security
@using Quickfire.Blazor.Domain.Shared.Components
@using Quickfire.Blazor.Data
@using Microsoft.FluentUI.AspNetCore.Components
@using Syncfusion.Blazor.RichTextEditor
@inject CompanyManualService ManualService
@inject TaskService TaskService
@inject IJSRuntime JSRuntime

<div class="company-manual">
    @* Toolbar *@
    <div class="company-manual__toolbar">
        <div class="company-manual__toolbar-left">
            @if (IsAdminView)
            {
                <FluentButton Appearance="Appearance.Accent" OnClick="BeginCreatePage">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Add())" Color="Color.Fill" Slot="start" />
                    New Page
                </FluentButton>
            }
            @if (_selectedPage != null && _viewMode == ManualViewMode.View)
            {
                @if (IsAdminView)
                {
                    <FluentButton Appearance="Appearance.Outline" OnClick="BeginEdit">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Slot="start" />
                        Edit
                    </FluentButton>
                }
                else
                {
                    <FluentButton Appearance="Appearance.Outline" OnClick="BeginSuggest">
                        <FluentIcon Value="@(new Icons.Regular.Size16.CommentAdd())" Slot="start" />
                        Suggest Edit
                    </FluentButton>
                }
                <FluentButton Appearance="Appearance.Outline" OnClick="PrintPageAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Print())" Slot="start" />
                    Print
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="PrintAllAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size16.DocumentPdf())" Slot="start" />
                    Print All
                </FluentButton>
            }
        </div>
        <div class="company-manual__toolbar-center">
            <FluentSearch @bind-Value="_searchQuery"
                          @bind-Value:after="HandleSearchAsync"
                          Placeholder="Search procedures..."
                          Immediate="true"
                          Style="width: 400px;" />
            @if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <FluentButton Appearance="Appearance.Stealth" OnClick="ClearSearch">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
                </FluentButton>
            }
        </div>
        <div class="company-manual__toolbar-right">
            @if (_isAdmin)
            {
                <FluentSwitch @bind-Value="_isUserMode" @bind-Value:after="OnUserModeChangedAsync">
                    <LabelTemplate>
                        <span>@(_isUserMode ? "User Mode" : "Admin Mode")</span>
                    </LabelTemplate>
                </FluentSwitch>
            }
            @if (IsAdminView)
            {
                <FluentCheckbox @bind-Value="_showArchived" @bind-Value:after="ReloadPagesAsync" Label="Show archived" />
            }
            <FluentButton Appearance="Appearance.Stealth" OnClick="ToggleToc" Title="Toggle table of contents">
                <FluentIcon Value="@(new Icons.Regular.Size20.PanelLeft())" />
            </FluentButton>
            <FluentButton Appearance="Appearance.Stealth" OnClick="ToggleSidebar" Title="Toggle metadata panel">
                <FluentIcon Value="@(new Icons.Regular.Size20.PanelRight())" />
            </FluentButton>
        </div>
    </div>

    @* Message Bar *@
    <FluentMessageBarProvider />
    
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <FluentMessageBar Intent="@_statusIntent" AllowDismiss="true" OnDismiss="ClearStatus">
            @_statusMessage
        </FluentMessageBar>
    }

    <div class="company-manual__layout @(_tocCollapsed ? "toc-collapsed" : "") @(_sidebarCollapsed ? "sidebar-collapsed" : "")">
        @if (!_tocCollapsed)
        {
            <div class="company-manual__toc">
                <div class="toc-header">
                    <div class="toc-title">
                        <FluentIcon Value="@(new Icons.Regular.Size20.BookOpen())" Color="Color.Custom" CustomColor="#a0a0a0" />
                        <span>Table of Contents</span>
                    </div>
                </div>

                @if (_isCreatingPage)
                {
                    <div class="toc-create">
                        <FluentTextField @bind-Value="_newPageTitle"
                                         Placeholder="Page title"
                                         Style="width:100%;" />
                        <div class="toc-create__meta">
                            <span>Parent: @_newPageParentLabel</span>
                        </div>
                        <div class="toc-create__actions">
                            <FluentButton Appearance="Appearance.Accent" OnClick="CreatePageAsync">Create</FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="CancelCreatePage">Cancel</FluentButton>
                        </div>
                    </div>
                }

                @if (_isLoading)
                {
                    <div class="toc-loading">
                        <FluentProgressRing Width="28px" />
                        <span>Loading manual...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <div class="toc-search-results">
                        @if (_searchResults.Count == 0)
                        {
                            <div class="toc-empty">No results found.</div>
                        }
                        else
                        {
                            @foreach (var result in _searchResults)
                            {
                                <div class="toc-search-item" @onclick="() => SelectSearchResultAsync(result)">
                                    <div class="toc-search-title">
                                        <span class="toc-title-text">
                                            @StripVideoSuffix(result.Title)
                                            @if (HasVideoSuffix(result.Title))
                                            {
                                                <span class="toc-video-icon" title="Video">
                                                    <FluentIcon Value="@(new Icons.Regular.Size16.Video())" />
                                                </span>
                                            }
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(result.Snippet))
                                    {
                                        <div class="toc-search-snippet">@result.Snippet</div>
                                    }
                                    <div class="toc-search-meta">
                                        @if (!string.IsNullOrWhiteSpace(result.ProcedureType))
                                        {
                                            <span>@result.ProcedureType</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(result.LineOfBusiness))
                                        {
                                            <span>@result.LineOfBusiness</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="toc-tree">
                        @RenderTree(_pageTree)
                    </div>
                }
            </div>
        }
        <div class="company-manual__viewer">
            @if (_selectedPage == null)
            {
                <div class="manual-empty">
                    <FluentIcon Value="@(new Icons.Regular.Size48.DocumentText())" Color="Color.Custom" CustomColor="#a0a0a0" />
                    <h4>Select a procedure</h4>
                    <p>Choose a page from the table of contents to view its published procedure.</p>
                </div>
            }
            else if (_viewMode == ManualViewMode.Edit)
            {
                <div class="manual-editor">
                    <div class="manual-editor__header">
                        <div class="manual-editor__header-title">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Edit())" Color="Color.Custom" CustomColor="#a0a0a0" />
                            <h4>Edit Procedure</h4>
                        </div>
                        <div class="manual-editor__actions">
                            <FluentButton Appearance="Appearance.Accent" OnClick="ShowPublishDialog">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Fill" Slot="start" />
                                Publish Revision
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="ShowMediaDialog">Insert Media</FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="CancelEditor">Cancel</FluentButton>
                        </div>
                    </div>
                    <div class="manual-editor__rte">
                        <SfRichTextEditor @ref="_richTextEditor" @bind-Value="_editorHtml" Height="calc(100vh - 280px)">
                            <RichTextEditorToolbarSettings Items="@_editorTools"></RichTextEditorToolbarSettings>
                        </SfRichTextEditor>
                    </div>
                </div>
            }
            else if (_viewMode == ManualViewMode.Suggest)
            {
                <div class="manual-editor">
                    <div class="manual-editor__header">
                        <div class="manual-editor__header-title">
                            <FluentIcon Value="@(new Icons.Regular.Size24.CommentAdd())" Color="Color.Custom" CustomColor="#a0a0a0" />
                            <h4>Suggest an Update</h4>
                        </div>
                        <div class="manual-editor__actions">
                            <FluentButton Appearance="Appearance.Accent" OnClick="ShowSuggestionDialog">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Send())" Color="Color.Fill" Slot="start" />
                                Submit Suggestion
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="ShowMediaDialog">Insert Media</FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="CancelEditor">Cancel</FluentButton>
                        </div>
                    </div>
                    <div class="manual-editor__rte">
                        <SfRichTextEditor @ref="_richTextEditor" @bind-Value="_editorHtml" Height="calc(100vh - 280px)">
                            <RichTextEditorToolbarSettings Items="@_editorTools"></RichTextEditorToolbarSettings>
                        </SfRichTextEditor>
                    </div>
                </div>
            }
            else if (_viewMode == ManualViewMode.ReviewSuggestion && _activeSuggestion != null)
            {
                <div class="manual-view">
                    <div class="manual-view__header">
                        <div>
                            <h2>@_activeSuggestion.Title</h2>
                            <div class="manual-view__sub">Reviewing suggestion from @GetUserDisplayName(_activeSuggestion.SubmittedById)</div>
                        </div>
                        <div class="manual-view__actions">
                            <FluentButton Appearance="Appearance.Outline" OnClick="ExitSuggestionReview">Back to Published</FluentButton>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_activeSuggestion.Summary))
                    {
                        <div class="manual-view__summary">@_activeSuggestion.Summary</div>
                    }
                    <div class="manual-view__body">
                        @SafeMarkup.SanitizedHtml(_activeSuggestion.ContentHtml)
                    </div>
                </div>
            }
            else if (_viewMode == ManualViewMode.RevisionPreview && _activeRevision != null)
            {
                <div class="manual-view">
                    <div class="manual-view__header">
                        <div>
                            <h2>@_activeRevision.Title</h2>
                            <div class="manual-view__sub">Viewing revision @_activeRevision.RevisionNumber</div>
                        </div>
                        <div class="manual-view__actions">
                            <FluentButton Appearance="Appearance.Outline" OnClick="ExitRevisionPreview">Back to Published</FluentButton>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_activeRevision.ChangeSummary))
                    {
                        <div class="manual-view__summary">@_activeRevision.ChangeSummary</div>
                    }
                    <div class="manual-view__body">
                        @SafeMarkup.SanitizedHtml(_activeRevision.ContentHtml)
                    </div>
                </div>
            }
            else
            {
                <div class="manual-view">
                <div class="manual-view__header">
                    <div class="manual-view__header-title">
                        <h2>@_selectedPage.Title</h2>
                        <div class="manual-view__sub">
                            @if (_selectedPage.IsArchived)
                            {
                                <span class="pill pill-archived">Archived</span>
                            }
                            else if (_selectedPage.PublishedRevision == null)
                            {
                                <span class="pill pill-draft">Unpublished</span>
                            }
                            @if (_selectedPage.PublishedRevision?.PublishedAt != null)
                            {
                                <span class="manual-view__last-updated">
                                    Last updated: @_selectedPage.PublishedRevision.PublishedAt.Value.ToString("MMM d, yyyy")
                                </span>
                            }
                        </div>
                    </div>
                    <div class="manual-view__actions">
                        @if (IsAdminView && !_selectedPage.IsArchived)
                        {
                            <FluentButton Appearance="Appearance.Outline" OnClick="ArchivePageAsync">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Archive())" Slot="start" />
                                Archive
                            </FluentButton>
                        }
                        else if (IsAdminView && _selectedPage.IsArchived)
                        {
                            <FluentButton Appearance="Appearance.Outline" OnClick="RestorePageAsync">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUndo())" Slot="start" />
                                Restore
                            </FluentButton>
                        }
                    </div>
                </div>
                    <div class="manual-view__body">
                        @if (_selectedPage.PublishedRevision == null)
                        {
                            <div class="manual-empty">
                                <FluentIcon Value="@(new Icons.Regular.Size48.DocumentAdd())" Color="Color.Custom" CustomColor="#a0a0a0" />
                                <p>No published revision yet. @(IsAdminView ? "Publish the first revision to make this procedure visible." : "Check back later for the published procedure.")</p>
                            </div>
                        }
                        else
                        {
                            @SafeMarkup.SanitizedHtml(_selectedPage.PublishedRevision.ContentHtml)
                        }
                    </div>
                </div>
            }
        </div>

        @if (!_sidebarCollapsed)
        {
            <div class="company-manual__sidebar">
                @if (_selectedPage != null)
                {
                    <div class="manual-card">
                        <div class="manual-card__header">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="Color.Custom" CustomColor="#a0a0a0" />
                            <h5>Metadata</h5>
                        </div>
                        <div class="manual-card__body">
                            @if (IsAdminView)
                        {
                            <FluentTextField @bind-Value="_selectedPage.ProcedureType" @bind-Value:after="PersistMetadataAsync" Label="Procedure Type" />
                            <FluentTextField @bind-Value="_selectedPage.LineOfBusiness" @bind-Value:after="PersistMetadataAsync" Label="Line of Business" />
                            <FluentTextField @bind-Value="_selectedPage.SlaTarget" @bind-Value:after="PersistMetadataAsync" Label="SLA Target" />
                            <FluentSelect TOption="string"
                                          Items="@GetOwnerOptions()"
                                          @bind-SelectedOption="OwnerUserId"
                                          @bind-SelectedOption:after="PersistMetadataAsync"
                                          OptionText="@(option => GetOwnerOptionText(option))"
                                          OptionValue="@(option => option)"
                                          Label="Owner" />
                            <FluentTextField @bind-Value="_parentFilter"
                                             Immediate="true"
                                             Label="Find Parent Page"
                                             Placeholder="Type to filter parent pages" />
                            @if (ShowParentFilterHint)
                            {
                                <div class="manual-field-hint">Showing top-level pages. Type to search all pages.</div>
                            }
                            <FluentSelect TOption="string"
                                          Items="@GetParentOptions()"
                                          @bind-SelectedOption="ParentSelection"
                                          @bind-SelectedOption:after="PersistParentAsync"
                                          OptionText="@(option => GetParentOptionText(option))"
                                          OptionValue="@(option => option)"
                                          Label="Parent Page" />
                            <FluentTextField @bind-Value="_selectedPage.Tags" @bind-Value:after="PersistMetadataAsync" Label="Tags" />
                            <FluentDatePicker @bind-Value="_selectedPage.EffectiveDate" @bind-Value:after="PersistMetadataAsync" Label="Effective Date" />
                            <FluentDatePicker @bind-Value="_selectedPage.ReviewBy" @bind-Value:after="PersistMetadataAsync" Label="Review By" />
                            <FluentNumberField @bind-Value="_selectedPage.ReviewCycleDays" @bind-Value:after="PersistMetadataAsync" Label="Review Cycle (days)" />
                            <FluentSelect TOption="string"
                                          Items="@GetTaskGroupOptions()"
                                          @bind-SelectedOption="TaskGroupSelection"
                                          @bind-SelectedOption:after="PersistMetadataAsync"
                                          OptionText="@(option => GetTaskGroupOptionText(option))"
                                          OptionValue="@(option => option)"
                                          Label="Timeline Task Group" />
                            <FluentTextArea @bind-Value="_selectedPage.Summary" @bind-Value:after="PersistMetadataAsync" Label="Summary" Rows="3" />
                        }
                        else
                            {
                                <div class="manual-meta">
                                    <div><span>Procedure Type:</span> @_selectedPage.ProcedureType</div>
                                    <div><span>Line of Business:</span> @_selectedPage.LineOfBusiness</div>
                                    <div><span>SLA Target:</span> @_selectedPage.SlaTarget</div>
                                    <div><span>Owner:</span> @GetUserDisplayName(_selectedPage.OwnerUserId)</div>
                                    <div><span>Effective Date:</span> @FormatDate(_selectedPage.EffectiveDate)</div>
                                    <div><span>Review By:</span> @FormatDate(_selectedPage.ReviewBy)</div>
                                    <div><span>Review Cycle:</span> @FormatDays(_selectedPage.ReviewCycleDays)</div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="manual-card">
                        <div class="manual-card__header">
                            <FluentIcon Value="@(new Icons.Regular.Size20.History())" Color="Color.Custom" CustomColor="#a0a0a0" />
                            <h5>Revision History</h5>
                        </div>
                        <div class="manual-card__body">
                        @if (_revisions.Count == 0)
                        {
                            <div class="manual-card__empty">No revisions yet.</div>
                        }
                        else
                        {
                            <div class="manual-list">
                                @foreach (var revision in _revisions)
                                {
                                    <div class="manual-list__item">
                                        <div>
                                            <strong>Revision @revision.RevisionNumber</strong>
                                            <div class="manual-list__meta">@FormatDateTime(revision.PublishedAt ?? revision.CreatedAt)</div>
                                        </div>
                                        <FluentButton Appearance="Appearance.Outline" OnClick="() => PreviewRevision(revision)">View</FluentButton>
                                    </div>
                                }
                            </div>
                        }
                        </div>
                    </div>

                    <div class="manual-card">
                        <div class="manual-card__header">
                            <FluentIcon Value="@(new Icons.Regular.Size20.CommentMultiple())" Color="Color.Custom" CustomColor="#a0a0a0" />
                            <h5>Suggestions</h5>
                        </div>
                        <div class="manual-card__body">
                        @if (IsAdminView)
                        {
                            @if (_suggestions.Count == 0)
                            {
                                <div class="manual-card__empty">No pending suggestions.</div>
                            }
                            else
                            {
                                <div class="manual-list">
                                    @foreach (var suggestion in _suggestions)
                                    {
                                        <div class="manual-list__item">
                                            <div>
                                                <strong>@suggestion.Title</strong>
                                                <div class="manual-list__meta">@GetUserDisplayName(suggestion.SubmittedById)</div>
                                            </div>
                                            <FluentButton Appearance="Appearance.Outline" OnClick="() => ReviewSuggestion(suggestion)">Review</FluentButton>
                                        </div>
                                    }
                                </div>
                                @if (_activeSuggestion != null)
                                {
                                    <div class="manual-review">
                                        <FluentTextArea @bind-Value="_reviewNotes" Label="Review notes" Rows="2" />
                                        <div class="manual-review__actions">
                                            <FluentButton Appearance="Appearance.Accent" OnClick="ApproveSuggestionAsync">Approve</FluentButton>
                                            <FluentButton Appearance="Appearance.Outline" OnClick="RejectSuggestionAsync">Reject</FluentButton>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="manual-card__empty">Suggestions are reviewed by the Company Manual admin.</div>
                        }
                        </div>
                    </div>

                    <div class="manual-card">
                        <div class="manual-card__header">
                            <FluentIcon Value="@(new Icons.Regular.Size20.Timeline())" Color="Color.Custom" CustomColor="#a0a0a0" />
                            <h5>Timeline Steps</h5>
                        </div>
                        <div class="manual-card__body">
                        @if (_timelineTasks.Count == 0)
                        {
                            <div class="manual-card__empty">No timeline linked.</div>
                        }
                        else
                        {
                            <ol class="manual-timeline">
                                @foreach (var task in _timelineTasks)
                                {
                                    <li>
                                        <div class="manual-timeline__title">@task.TaskName</div>
                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <div class="manual-timeline__desc">@task.Description</div>
                                        }
                                        @if (task.SubTaskLinks.Any())
                                        {
                                            <ul class="manual-timeline__sub">
                                                @foreach (var link in task.SubTaskLinks.OrderBy(st => st.OrderNumber))
                                                {
                                                    <li>@link.SubTaskMaster.TaskName</li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        </div>
                    </div>

                    @if (IsAdminView)
                    {
                        <div class="manual-card">
                            <div class="manual-card__header">
                                <FluentIcon Value="@(new Icons.Regular.Size20.ClipboardTaskListLtr())" Color="Color.Custom" CustomColor="#a0a0a0" />
                                <h5>Audit Trail</h5>
                            </div>
                            <div class="manual-card__body">
                            @if (_auditEntries.Count == 0)
                            {
                                <div class="manual-card__empty">No audit entries yet.</div>
                            }
                            else
                            {
                                <div class="manual-list">
                                    @foreach (var entry in _auditEntries)
                                    {
                                        <div class="manual-list__item manual-list__item--compact">
                                            <div>
                                                <strong>@entry.Action</strong>
                                                <div class="manual-list__meta">@GetAuditMeta(entry)</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@* Publish/Edit Confirmation Dialog *@
<BaseDialog DialogId="publish-confirmation"
            Title="@_dialogTitle"
            @bind-Hidden="_publishDialogHidden">
    <ChildContent>
        <div class="manual-dialog-content">
            <FluentTextField @bind-Value="_editorTitle" Label="Title" Style="width: 100%; margin-bottom: 12px;" />
            <FluentTextArea @bind-Value="_changeSummary" Label="Change summary (optional)" Rows="3" Style="width: 100%;" />
        </div>
    </ChildContent>
    <FooterContent>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmPublishAsync">
            <FluentIcon Value="@(new Icons.Regular.Size16.Checkmark())" Color="Color.Fill" Slot="start" />
            Confirm
        </FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="CancelPublishDialog">Cancel</FluentButton>
    </FooterContent>
</BaseDialog>

@* Video Lightbox/Theater Mode *@
<div class="manual-video-lightbox @(_videoLightboxOpen ? "open" : "")" @onclick="CloseVideoLightbox">
    <div class="manual-video-lightbox__content" @onclick:stopPropagation>
        <button class="manual-video-lightbox__close" @onclick="CloseVideoLightbox">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Close
        </button>
        @if (!string.IsNullOrEmpty(_lightboxVideoSrc))
        {
            <video class="manual-video-lightbox__video" src="@_lightboxVideoSrc" controls autoplay></video>
        }
        <div class="manual-video-lightbox__hint">
            <kbd>Esc</kbd> to close
        </div>
    </div>
</div>

@* Image Lightbox *@
<div class="manual-image-lightbox @(_imageLightboxOpen ? "open" : "")" @onclick="CloseImageLightbox">
    @if (!string.IsNullOrEmpty(_lightboxImageSrc))
    {
        <img src="@_lightboxImageSrc" alt="@_lightboxImageAlt" />
    }
</div>

@* Media Insert Dialog - Beautiful & Creative Design *@
<BaseDialog DialogId="manual-media-insert"
            Title="🎬 Insert Media"
            @bind-Hidden="_mediaDialogHidden">
    <ChildContent>
        <div class="media-dialog">
            @* Gradient Header Strip *@
            <div class="media-dialog__header-strip"></div>
            
            @* Media Type Selector *@
            <div class="media-dialog__type-selector">
                <button class="media-type-btn @(_selectedMediaType == MediaInsertType.Image ? "active" : "")" 
                        @onclick="() => _selectedMediaType = MediaInsertType.Image">
                    @if (_selectedMediaType == MediaInsertType.Image)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size24.Image())" Color="Color.Fill" />
                    }
                    else
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size24.Image())" Color="Color.Custom" CustomColor="#6b7280" />
                    }
                    <span>Image</span>
                </button>
                <button class="media-type-btn @(_selectedMediaType == MediaInsertType.Video ? "active" : "")" 
                        @onclick="() => _selectedMediaType = MediaInsertType.Video">
                    @if (_selectedMediaType == MediaInsertType.Video)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size24.Video())" Color="Color.Fill" />
                    }
                    else
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size24.Video())" Color="Color.Custom" CustomColor="#6b7280" />
                    }
                    <span>Video</span>
                </button>
            </div>

            @* Path Input Tabs *@
            <div class="media-dialog__tabs">
                <button class="media-tab @(_mediaPathMode == MediaPathMode.Http ? "active" : "")" 
                        @onclick="() => SwitchPathMode(MediaPathMode.Http)">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Globe())" />
                    <span>Web URL</span>
                </button>
                <button class="media-tab @(_mediaPathMode == MediaPathMode.NetworkDrive ? "active" : "")" 
