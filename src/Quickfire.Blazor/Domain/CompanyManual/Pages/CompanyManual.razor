    private string GetPreviewUrl()
    {
        var path = GetCurrentMediaPath();
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        // For HTTP URLs, use directly
        if (Uri.TryCreate(path.Trim(), UriKind.Absolute, out var uri) &&
            (uri.Scheme.Equals("http", StringComparison.OrdinalIgnoreCase) ||
             uri.Scheme.Equals("https", StringComparison.OrdinalIgnoreCase)))
        {
            return uri.AbsoluteUri;
        }

        // For network paths, try to convert to file:// URL
        return ConvertToFileUrl(path);
    }

    private static string ConvertToFileUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var trimmed = path.Trim();

        // Handle UNC paths (\\server\share\...)
        if (trimmed.StartsWith(@"\\"))
        {
            // Convert \\server\share\path to file://server/share/path
            var uncPath = trimmed.Substring(2).Replace('\\', '/');
            return $"file://{uncPath}";
        }

        // Handle mapped drive paths (S:\folder\...)
        if (System.IO.Path.IsPathRooted(trimmed))
        {
            try
            {
                return new Uri(trimmed).AbsoluteUri;
            }
            catch (UriFormatException)
            {
                // Fallback: manual conversion
                return $"file:///{trimmed.Replace('\\', '/').Replace(" ", "%20")}";
            }
        }

        return trimmed;
    }

