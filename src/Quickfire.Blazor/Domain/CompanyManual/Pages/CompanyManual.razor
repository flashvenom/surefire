    private static string TruncatePath(string path, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(path) || path.Length <= maxLength)
        {
            return path;
        }

        var start = path.Substring(0, 15);
        var end = path.Substring(path.Length - (maxLength - 18));
        return $"{start}...{end}";
    }

    private async Task InsertMediaFromDialogAsync()
    {
        var primaryPath = GetCurrentMediaPath();
        if (string.IsNullOrWhiteSpace(primaryPath))
        {
            ShowStatus("Enter a media file path or URL.", MessageIntent.Warning);
            return;
        }

        var normalizedPrimary = NormalizeMediaPath(primaryPath);
        var normalizedFallback = !string.IsNullOrWhiteSpace(_fallbackUrl) 
            ? NormalizeMediaPath(_fallbackUrl) 
            : null;

        if (string.IsNullOrWhiteSpace(normalizedPrimary))
        {
            ShowStatus("Unable to use that media path.", MessageIntent.Warning);
            return;
        }

        string html;

        if (_selectedMediaType == MediaInsertType.Image)
        {
            html = GenerateImageHtml(normalizedPrimary, normalizedFallback, _mediaAltText);
        }
        else
        {
            html = GenerateVideoHtml(normalizedPrimary, normalizedFallback);
        }

        await InsertHtmlAsync(html);
        
        // Clear and close the dialog
        _httpUrl = string.Empty;
        _networkDrivePath = string.Empty;
        _uncPath = string.Empty;
        _fallbackUrl = string.Empty;
        _mediaAltText = string.Empty;
        _previewStatus = string.Empty;
        _mediaDialogHidden = true;

        ShowStatus($"{(_selectedMediaType == MediaInsertType.Image ? "Image" : "Video")} inserted successfully!", MessageIntent.Success);
    }

    private static string GenerateImageHtml(string primarySrc, string? fallbackSrc, string altText)
    {
        var encodedPrimary = SafeMarkup.HtmlEncode(primarySrc);
        var encodedAlt = SafeMarkup.HtmlEncode(altText);

        if (!string.IsNullOrWhiteSpace(fallbackSrc))
        {
            var encodedFallback = SafeMarkup.HtmlEncode(fallbackSrc);
            // Use onerror to fallback to secondary source
            return $"<img class=\"manual-media manual-media--image\" src=\"{encodedPrimary}\" alt=\"{encodedAlt}\" onerror=\"this.onerror=null; this.src='{encodedFallback}';\" />";
        }

        return $"<img class=\"manual-media manual-media--image\" src=\"{encodedPrimary}\" alt=\"{encodedAlt}\" />";
    }

    private string GenerateVideoHtml(string primarySrc, string? fallbackSrc)
    {
        var encodedPrimary = SafeMarkup.HtmlEncode(primarySrc);
        var primaryMime = GetVideoMimeType(primarySrc);

        var sources = new System.Text.StringBuilder();
        
        // Primary source
        if (!string.IsNullOrWhiteSpace(primaryMime))
        {
            sources.Append($"<source src=\"{encodedPrimary}\" type=\"{primaryMime}\">");
        }
        else
        {
            sources.Append($"<source src=\"{encodedPrimary}\">");
        }

        // Fallback source if provided
        if (!string.IsNullOrWhiteSpace(fallbackSrc))
        {
            var encodedFallback = SafeMarkup.HtmlEncode(fallbackSrc);
            var fallbackMime = GetVideoMimeType(fallbackSrc);
            
            if (!string.IsNullOrWhiteSpace(fallbackMime))
            {
                sources.Append($"<source src=\"{encodedFallback}\" type=\"{fallbackMime}\">");
            }
            else
            {
                sources.Append($"<source src=\"{encodedFallback}\">");
            }
        }

        return $"<div class=\"manual-video-wrapper\"><video class=\"manual-media manual-media--video\" controls preload=\"metadata\">{sources}</video></div>";
    }

