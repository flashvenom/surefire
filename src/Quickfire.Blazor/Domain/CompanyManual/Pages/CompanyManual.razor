    private static string NormalizeMediaPath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var trimmed = path.Trim();
        if (Uri.TryCreate(trimmed, UriKind.Absolute, out var absoluteUri)
            && (absoluteUri.Scheme.Equals("http", StringComparison.OrdinalIgnoreCase)
                || absoluteUri.Scheme.Equals("https", StringComparison.OrdinalIgnoreCase)
                || absoluteUri.Scheme.Equals("file", StringComparison.OrdinalIgnoreCase)))
        {
            return absoluteUri.AbsoluteUri;
        }

        if (System.IO.Path.IsPathRooted(trimmed))
        {
            try
            {
                return new Uri(trimmed).AbsoluteUri;
            }
            catch (UriFormatException)
            {
                return trimmed.Replace('\\', '/');
            }
        }

        return trimmed;
    }

    private static string? GetVideoMimeType(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        var extension = System.IO.Path.GetExtension(path);
        if (string.IsNullOrWhiteSpace(extension) && Uri.TryCreate(path, UriKind.Absolute, out var uri))
        {
            extension = System.IO.Path.GetExtension(uri.LocalPath);
        }

        return extension?.ToLowerInvariant() switch
        {
            ".mp4" => "video/mp4",
            ".webm" => "video/webm",
            ".ogg" => "video/ogg",
            ".ogv" => "video/ogg",
            _ => null
        };
    }

