    private async Task OnUserModeChangedAsync()
    {
        if (!_isAdmin)
        {
            return;
        }

        if (_isUserMode)
        {
            _isCreatingPage = false;
            _viewMode = ManualViewMode.View;
            _activeSuggestion = null;
            _activeRevision = null;
            _reviewNotes = string.Empty;
            _suggestions.Clear();
            _auditEntries.Clear();
        }

        var selectedPageId = _selectedPage?.CompanyManualPageId;
        await ReloadPagesAsync();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            await HandleSearchAsync();
        }

        if (selectedPageId.HasValue)
        {
            var page = _pages.FirstOrDefault(p => p.CompanyManualPageId == selectedPageId.Value);
            if (page != null)
            {
                await SelectPageAsync(page, false);
                return;
            }
        }

        await SelectInitialPageAsync();
    }

