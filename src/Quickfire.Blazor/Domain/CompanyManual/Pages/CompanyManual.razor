    private List<PageNode> BuildTree(IEnumerable<CompanyManualPage> pages)
    {
        var pageList = pages.ToList();
        var roots = pageList
            .Where(p => p.ParentPageId == null)
            .OrderBy(p => p.SortOrder)
            .ThenBy(p => p.Title)
            .ToList();

        var lookup = pageList
            .Where(p => p.ParentPageId.HasValue)
            .GroupBy(p => p.ParentPageId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(p => p.SortOrder).ThenBy(p => p.Title).ToList());

        List<PageNode> BuildNodes(int? parentId, PageNode? parentNode)
        {
            List<CompanyManualPage> children;
            if (!parentId.HasValue)
            {
                children = roots;
            }
            else if (!lookup.TryGetValue(parentId.Value, out children))
            {
                return new List<PageNode>();
            }

            return children
                .Select(child =>
                {
                    var node = new PageNode(child)
                    {
                        Parent = parentNode
                    };
                    node.Children = BuildNodes(child.CompanyManualPageId, node);
                    return node;
                })
                .ToList();
        }

        return BuildNodes(null, null);
    }

    private sealed class PageNode
    {
        public PageNode(CompanyManualPage page)
        {
            Page = page;
        }

        public CompanyManualPage Page { get; }
        public PageNode? Parent { get; set; }
        public List<PageNode> Children { get; set; } = new();
    }

