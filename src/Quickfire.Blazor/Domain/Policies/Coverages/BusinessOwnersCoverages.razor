}

@code {
    [Parameter] public int PolicyId { get; set; }

    private BusinessOwnersPolicyCoverage? BusinessOwnersCoverage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadCoverageAsync();
    }

    private async Task LoadCoverageAsync()
    {
        BusinessOwnersCoverage = await PolicyService.GetBusinessOwnersPolicyCoverageByPolicyIdAsync(PolicyId);

        if (BusinessOwnersCoverage is null)
        {
            BusinessOwnersCoverage = new BusinessOwnersPolicyCoverage
            {
                PolicyId = PolicyId,
                DateCreated = DateTime.UtcNow,
                DateModified = DateTime.UtcNow
            };

            BusinessOwnersCoverage = await PolicyService.UpsertBusinessOwnersPolicyCoverageAsync(BusinessOwnersCoverage);
        }
    }

    private async Task UpdateCoverageAsync()
    {
        if (BusinessOwnersCoverage is null)
        {
            return;
        }

        BusinessOwnersCoverage.DateModified = DateTime.UtcNow;
        BusinessOwnersCoverage = await PolicyService.UpsertBusinessOwnersPolicyCoverageAsync(BusinessOwnersCoverage);
        StateHasChanged();
    }
}

<style>
    .bop-coverages {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .coverage-section {
        padding: 16px;
        background-color: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        border-radius: 10px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .field-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .field-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field-item.full-width {
        grid-column: 1 / -1;
    }

    .loading-spinner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
    }
</style>

