    private async Task DuplicateMasterTask(TaskMaster sourceTask)
    {
        if (SelectedTaskGroup == null || sourceTask == null) return;

        var duplicateTask = new TaskMaster
        {
            TaskName = string.IsNullOrWhiteSpace(sourceTask.TaskName) ? "Task Copy" : $"{sourceTask.TaskName} (Copy)",
            Description = sourceTask.Description,
            DaysBeforeExpiration = sourceTask.DaysBeforeExpiration,
            ForType = sourceTask.ForType,
            Important = sourceTask.Important,
            DefaultAssignedToId = sourceTask.DefaultAssignedToId
        };

        var savedDuplicate = await TaskService.AddTaskMasterAsync(duplicateTask);
        savedDuplicate.SubTaskLinks ??= new List<TaskMasterSubTask>();

        var sourceIndex = TaskItems.IndexOf(sourceTask);
        var insertOrder = sourceIndex >= 0 ? sourceIndex + 1 : TaskItems.Count;

        await TaskService.AddTaskToGroupAsync(new TaskGroupTaskMaster
        {
            TaskGroupId = SelectedTaskGroup.TaskGroupId,
            TaskMasterId = savedDuplicate.TaskMasterId,
            OrderNumber = insertOrder
        });

        if (sourceTask.SubTaskLinks != null && sourceTask.SubTaskLinks.Count > 0)
        {
            var orderedLinks = sourceTask.SubTaskLinks.OrderBy(link => link.OrderNumber).ToList();
            foreach (var link in orderedLinks)
            {
                var sourceSubtask = link.SubTaskMaster;
                if (sourceSubtask == null)
                {
                    continue;
                }

                var newSubtask = new TaskMaster
                {
                    TaskName = sourceSubtask.TaskName,
                    Description = sourceSubtask.Description,
                    DaysBeforeExpiration = sourceSubtask.DaysBeforeExpiration,
                    ForType = sourceSubtask.ForType,
                    Important = sourceSubtask.Important,
                    DefaultAssignedToId = sourceSubtask.DefaultAssignedToId
                };

                var savedSubtask = await TaskService.AddTaskMasterAsync(newSubtask);
                var nextOrder = savedDuplicate.SubTaskLinks.Count;
                await TaskService.AssignSubtaskAsync(savedDuplicate.TaskMasterId, savedSubtask.TaskMasterId, nextOrder);

                savedDuplicate.SubTaskLinks.Add(new TaskMasterSubTask
                {
                    ParentTaskMasterId = savedDuplicate.TaskMasterId,
                    SubTaskMasterId = savedSubtask.TaskMasterId,
                    OrderNumber = nextOrder,
                    SubTaskMaster = savedSubtask
                });
            }
        }

        var localInsertIndex = insertOrder;
        if (localInsertIndex < 0)
        {
            localInsertIndex = 0;
        }
        if (localInsertIndex > TaskItems.Count)
        {
            localInsertIndex = TaskItems.Count;
        }

        TaskItems.Insert(localInsertIndex, savedDuplicate);
        StateHasChanged();
    }

