    private async Task OnTaskGroupNameCommitted(string value)
    {
        if (SelectedTaskGroup == null) return;

        var nextValue = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(nextValue))
        {
            TaskGroupNameEdit = SelectedTaskGroup.Name ?? string.Empty;
            return;
        }

        if (string.Equals(SelectedTaskGroup.Name ?? string.Empty, nextValue, System.StringComparison.Ordinal))
        {
            return;
        }

        SelectedTaskGroup.Name = nextValue;
        TaskGroupNameEdit = nextValue;
        await TaskService.UpdateTaskGroupAsync(SelectedTaskGroup);
        FilterTaskGroups();
    }

    private async Task OnTaskGroupDescriptionCommitted(string value)
