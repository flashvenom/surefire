    private async Task ConfirmDeleteTaskGroup()
    {
        if (SelectedTaskGroup == null) return;

        try
        {
            var groupId = SelectedTaskGroup.TaskGroupId;
            await TaskService.DeleteTaskGroupAsync(groupId);

            AllTaskGroups = AllTaskGroups
                .Where(tg => tg.TaskGroupId != groupId)
                .ToList();

            FilterTaskGroups();

            SelectedTaskGroup = FilteredTaskGroups.FirstOrDefault();
            if (SelectedTaskGroup != null)
            {
                await LoadTasksForGroup();
            }
            else
            {
                TaskItems.Clear();
            }

            ShowDeleteConfirmation = false;
            StateHasChanged();
            await RefreshSortable();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting task group: {ex.Message}");
            ShowDeleteConfirmation = false;
            StateHasChanged();
        }
    }

