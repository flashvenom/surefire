    private void FilterTaskGroups()
    {
        if (string.IsNullOrWhiteSpace(TaskGroupSearchQuery))
        {
            FilteredTaskGroups = AllTaskGroups
                .OrderBy(tg => tg.Name ?? string.Empty, System.StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else
        {
            var query = TaskGroupSearchQuery.Trim().ToLowerInvariant();
            FilteredTaskGroups = AllTaskGroups
                .Where(tg =>
                    (tg.Name?.ToLowerInvariant().Contains(query) ?? false) ||
                    (tg.Description?.ToLowerInvariant().Contains(query) ?? false))
                .OrderBy(tg => tg.Name ?? string.Empty, System.StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

