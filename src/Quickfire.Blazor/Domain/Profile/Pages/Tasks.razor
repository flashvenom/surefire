    private async Task DeleteMasterTask(TaskMaster task)
    {
        if (await ConfirmDelete($"Are you sure you want to delete the task '{task.TaskName}'? This will also remove all its subtasks."))
        {
            try
            {
                // First, delete all subtasks and their links
                if (task.SubTaskLinks != null && task.SubTaskLinks.Any())
                {
                    var subtaskLinks = task.SubTaskLinks.ToList(); // Create a copy to avoid collection modification
                    foreach (var subtaskLink in subtaskLinks)
                    {
                        // Unassign the subtask first
                        await TaskService.UnassignSubtaskAsync(task.TaskMasterId, subtaskLink.SubTaskMasterId);

                        // Delete the subtask TaskMaster if it's a dedicated subtask
                        if (subtaskLink.SubTaskMaster?.ForType == "sub")
                        {
                            await TaskService.DeleteTaskMasterAsync(subtaskLink.SubTaskMasterId);
                        }
                    }
                }

                // Now delete the parent task
                await TaskService.DeleteTaskMasterAsync(task.TaskMasterId);
                TaskItems.Remove(task);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting task: {ex.Message}");
                // Optionally show an error message to the user
            }
        }
    }

